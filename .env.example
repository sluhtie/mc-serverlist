# Copy to .env for local development without Docker: cp .env.example .env

# PostgreSQL connection string (or leave it out and set PGHOST/PGUSER/PGPASSWORD/PGDATABASE)
DATABASE_URL=postgres://mcsl:mcsl@localhost:5432/mcsl

# Public URL of the site (used for metadata, sitemap and secure cookies)
APP_URL=http://localhost:3000

# Display name of the list
SITE_NAME=MCServerlist

# Optional: Google Search Console verification code (content of the HTML meta tag)
GOOGLE_SITE_VERIFICATION=

# Long random string, used to hash IP addresses and encrypt 2FA secrets. Required in production.
# Changing it later disables every user's authenticator app.
# Generate one with: openssl rand -base64 48
APP_SECRET=dev-secret-change-me

# Outgoing mail (address confirmation, password reset, security notices).
# Without SMTP_HOST mails are skipped with a warning. Mailpit for local testing:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit  ->  SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS; defaults to true for port 465, STARTTLS is used on 587 automatically.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender address, defaults to "<SITE_NAME> <noreply@<domain of APP_URL>>"
MAIL_FROM=

# Operator details for the imprint (Impressum) and privacy policy. Kept out of the repository on purpose.
# LEGAL_ADDRESS is comma-separated, one part per line: "Musterstraße 1, 12345 Berlin"
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
# Optional free text naming the hosting provider and the SMTP provider in the privacy policy
LEGAL_HOSTING=
LEGAL_MAIL_PROVIDER=

# Comma-separated e-mails that become admins on register/login
ADMIN_EMAILS=admin@example.com

# Optional: Cloudflare Turnstile captcha on the vote page
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Background status pings (disable on all but one instance when scaling out)
STATUS_WORKER_ENABLED=true
STATUS_INTERVAL_SECONDS=300

# Allow pinging servers on private/local IPs. Only for local testing!
ALLOW_PRIVATE_ADDRESSES=false
